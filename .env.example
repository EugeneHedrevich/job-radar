# SAP Job Radar - example environment file.
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Telegram (optional) -----------------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
# Without these, notifications are queued in SQLite but not delivered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OpenAI (optional) -------------------------------------------------------
# Without a key the tool still works: matching falls back to the deterministic
# rule engine only.
OPENAI_API_KEY=
# Overrides llm.model from config/settings.yaml.
OPENAI_MODEL=

# --- Paths (optional) --------------------------------------------------------
# Missing, empty or whitespace-only values use the defaults below.
# Relative paths resolve from the project root; surrounding whitespace is trimmed.
# Persistent directory for the SQLite database. Defaults to storage.db_dir (./data).
JOB_RADAR_DB_DIR=
# Python interpreter used for JobSpy. Defaults to collector.python (./.venv/bin/python).
JOB_RADAR_PYTHON=
# Collector script. Defaults to collector.script (./python/collector.py).
JOB_RADAR_COLLECTOR_SCRIPT=
# Alternative configuration directory. Defaults to ./config
JOB_RADAR_CONFIG_DIR=

# --- Logging (optional) ------------------------------------------------------
# debug | info | warn | error
JOB_RADAR_LOG_LEVEL=info

# SAP Job Radar - example environment file.
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Telegram (optional) -----------------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
# Without these, notifications are queued in SQLite but not delivered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OpenAI (optional) -------------------------------------------------------
# Without a key the tool still works: matching falls back to the deterministic
# rule engine only.
OPENAI_API_KEY=
# Overrides llm.model from config/settings.yaml.
OPENAI_MODEL=

# --- Paths (optional) --------------------------------------------------------
# Persistent directory for the SQLite database. Overrides storage.db_dir.
JOB_RADAR_DB_DIR=
# Python interpreter used for the JobSpy collector. Overrides collector.python.
JOB_RADAR_PYTHON=
# Alternative configuration directory. Defaults to ./config
JOB_RADAR_CONFIG_DIR=

# --- Logging (optional) ------------------------------------------------------
# debug | info | warn | error
JOB_RADAR_LOG_LEVEL=info

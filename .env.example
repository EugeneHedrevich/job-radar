# Copy to .env and fill in. Never commit .env or real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
# Optional override for settings.yaml llm.model.
OPENAI_MODEL=

# Blank values use the configured defaults. Paths resolve from the project root.
JOB_RADAR_DB_DIR=
JOB_RADAR_PYTHON=
JOB_RADAR_COLLECTOR_SCRIPT=
JOB_RADAR_CONFIG_DIR=
JOB_RADAR_LOG_LEVEL=info
# Optional local dashboard API port (default 3210); Vite remains on 5173.
JOB_RADAR_PORT=

# Optional single proxy for searches and enrichment. A missing scheme means http.
# Format: http://host:port or http://user:password@host:port (URL-encode credentials).
# Supported schemes: http, https, socks5. Never commit real proxy credentials.
JOB_RADAR_PROXY=
# Optional trusted PEM CA bundle, absolute path or relative to the project root.
# TLS verification remains enabled, including with a proxy.
JOB_RADAR_CA_BUNDLE=
